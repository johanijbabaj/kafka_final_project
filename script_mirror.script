curl -X PUT -H "Content-Type: application/json" --data '{"name": "mirror2", "connector.class": "org.apache.kafka.connect.mirror.MirrorSourceConnector", "source.cluster.alias": "source", "topics": "test_topic, products, filtered_products", "source.cluster.bootstrap.servers": "kafka-0:9092", "target.cluster.bootstrap.servers": "kafka-mirror-0:19092", "producer.override.bootstrap.servers": "kafka-mirror-0:19092", "offset-syncs.topic.replication.factor": "1"}' http://localhost:8083/connectors/mirror2/config
curl -X PUT -H "Content-Type: application/json" --data '{"name": "mirror2_products_search", "connector.class": "org.apache.kafka.connect.mirror.MirrorSourceConnector", "source.cluster.alias": "source", "topics": "product_search_topic", "source.cluster.bootstrap.servers": "kafka-0:9092", "target.cluster.bootstrap.servers": "kafka-mirror-0:19092", "producer.override.bootstrap.servers": "kafka-mirror-0:19092", "offset-syncs.topic.replication.factor": "1", "key.converter": "org.apache.kafka.connect.converters.ByteArrayConverter", "value.converter": "org.apache.kafka.connect.converters.ByteArrayConverter"}' http://localhost:8083/connectors/mirror2_products_search/config

curl http://localhost:8083/connectors/ | jq 
